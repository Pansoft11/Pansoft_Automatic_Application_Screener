{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Validate project files",
      "type": "shell",
      "command": "pwsh -File ./scripts/validate.ps1",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Setup environment",
      "type": "shell",
      "command": "pwsh -File ./scripts/setup.ps1",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Deploy solution",
      "type": "shell",
      "command": "pwsh -File ./scripts/deploy.ps1",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
